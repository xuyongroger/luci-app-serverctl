msgstr "服务器 MAC 地址（用于 WOL 唤醒）"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "SSH username"
msgstr "SSH 用户名"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "SSH password"
msgstr "SSH 密码"

#: root/usr/share/rpcd/acl.d/luci-app-serverctl.json:3
