msgstr "唤醒"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "Sleep"
msgstr "休眠"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "Shutdown"
msgstr "关机"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "Are you sure you want to suspend this server?"
msgstr "确定要休眠此服务器吗？"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "Are you sure you want to shut down this server?"
msgstr "确定要关闭此服务器吗？"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "succeeded."
msgstr "成功。"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "failed:"
msgstr "失败："

#: htdocs/luci-static/resources/view/serverctl.js
msgid "Scheduled Tasks"
msgstr "定时任务"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "Configure scheduled wake/sleep/shutdown tasks."
msgstr "配置定时唤醒 / 休眠 / 关机任务。"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "Action"
msgstr "操作"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "Day"
msgstr "日期"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "Cron day: 1-7 (1=Monday), ranges like 1-5, or * for daily"
msgstr "Cron 日期：1-7（1=周一），范围如 1-5，或 * 表示每天"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "Hour"
msgstr "小时"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "0-23, or * for every hour"
msgstr "0-23，或 * 表示每小时"

#: htdocs/luci-static/resources/view/serverctl.js
