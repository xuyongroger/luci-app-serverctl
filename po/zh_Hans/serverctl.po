#: htdocs/luci-static/resources/view/serverctl.js
msgid "Server Control"
msgstr "服务器控制"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "Manage LAN servers: Wake-on-LAN, SSH control, and scheduled tasks."
msgstr "管理局域网服务器：网络唤醒、SSH 控制和定时任务。"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "Manual/Scheduled Control"
