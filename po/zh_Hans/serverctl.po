msgid "Server"
msgstr "服务器"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "Name"
msgstr "名称"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "IP Address"
msgstr "IP 地址"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "MAC Address"
msgstr "MAC 地址"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "Username"
msgstr "用户名"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "Password"
msgstr "密码"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "Ping Test"
msgstr "Ping 测试"

#: htdocs/luci-static/resources/view/serverctl.js
