msgid "Server name/label"
msgstr "服务器名称 / 标签"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "Server IP address"
msgstr "服务器 IP 地址"

#: htdocs/luci-static/resources/view/serverctl.js
