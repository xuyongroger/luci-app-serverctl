#: htdocs/luci-static/resources/view/serverctl.js
msgid "Manual Control"
msgstr "手动控制"

#: htdocs/luci-static/resources/view/serverctl.js
msgid "No servers configured. Please add servers in the \"Server Maintenance\" tab."
msgstr "未配置服务器。请在「服务器维护」选项卡中添加服务器。"

