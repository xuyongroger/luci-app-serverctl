#!/bin/sh /etc/rc.common
# 遵循 ImmortalWrt procd 标准初始化流程

START=99
USE_PROCD=1

start_service() {
	# 清理旧的本插件定时任务
	sed -i '/#serverctl_task/d' /etc/crontabs/root 2>/dev/null || true

	config_load serverctl
	config_foreach apply_task task

	# 重启 cron 服务以生效
	/etc/init.d/cron restart
}

apply_task() {
	local cfg="$1"
	local enabled server action min hour

	config_get_bool enabled "$cfg" enabled 0
	[ "$enabled" -eq 1 ] || return 0

	config_get server "$cfg" server ""
	config_get action "$cfg" action ""
	config_get min "$cfg" min "*"
	config_get hour "$cfg" hour "*"

	[ -z "$server" ] || [ -z "$action" ] && return 0

	# 生成标准的 cron 计划任务并指向刚才写的 ubus 接口
	echo "$min $hour * * * ubus call serverctl execute '{\"server\":\"$server\", \"action\":\"$action\"}' #serverctl_task_$cfg" >> /etc/crontabs/root
}

service_triggers() {
	procd_add_reload_trigger "serverctl"
}
