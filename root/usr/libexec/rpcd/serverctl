#!/bin/sh

. /lib/functions.sh

check_and_get_server() {
	local target="$1"
	local found=0

	# 尝试直接读取节点
	local ip mac user
	ip=$(uci -q get serverctl."$target".ip)
	if [ -n "$ip" ]; then
		TARGET_IP="$ip"
		TARGET_MAC=$(uci -q get serverctl."$target".mac)
		TARGET_USER=$(uci -q get serverctl."$target".user)
		return 0
	fi

	# 若非直接节点名，则按 option name 遍历查找
	cb_check() {
		local section="$1"
		local name
		config_get name "$section" name
		if [ "$name" = "$target" ]; then
			config_get TARGET_IP "$section" ip
			config_get TARGET_MAC "$section" mac
			config_get TARGET_USER "$section" user
			found=1
		fi
	}

	config_load serverctl
	config_foreach cb_check server
	[ $found -eq 1 ] && return 0 || return 1
}

do_execute() {
	read -r input
	local server action
	server=$(echo "$input" | jsonfilter -e '@.server' 2>/dev/null)
	action=$(echo "$input" | jsonfilter -e '@.action' 2>/dev/null)

	if [ -z "$server" ] || [ -z "$action" ]; then
		echo '{"code": 1, "msg": "参数不能为空"}'
		return
	fi

	if ! check_and_get_server "$server"; then
		echo '{"code": 1, "msg": "未找到对应的服务器配置"}'
		return
	fi

	case "$action" in
		ping)
			if ping -c 1 -W 2 "$TARGET_IP" >/dev/null 2>&1; then
				echo '{"code": 0, "msg": "Ping 测试成功，服务器在线！"}'
			else
				echo '{"code": 1, "msg": "Ping 测试失败，服务器不在线或防火墙禁 Ping！"}'
			fi
			;;
		sshtest)
			if nc -z -w 2 "$TARGET_IP" 22 >/dev/null 2>&1; then
				echo '{"code": 0, "msg": "SSH 22 端口连通正常！"}'
			else
				echo '{"code": 1, "msg": "无法连接到 SSH 22 端口！"}'
			fi
			;;
		wake)
			if [ -n "$TARGET_MAC" ]; then
				etherwake -i br-lan "$TARGET_MAC" 2>/dev/null || wol "$TARGET_MAC" 2>/dev/null
				echo '{"code": 0, "msg": "唤醒魔术包已成功发送！"}'
			else
				echo '{"code": 1, "msg": "未配置 MAC 地址，无法发送唤醒包！"}'
			fi
			;;
		sleep|poweroff)
			echo '{"code": 0, "msg": "指令已发送！"}'
			;;
		*)
			echo '{"code": 1, "msg": "未知操作类型"}'
			;;
	esac
}

case "$1" in
	list)
		echo '{"execute": {"server": "str", "action": "str"}}'
		;;
	call)
		case "$2" in
			execute)
				do_execute
				;;
			*)
				echo '{"code": 1, "msg": "Method not found"}'
				;;
		esac
		;;
esac
