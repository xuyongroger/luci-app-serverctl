#!/bin/sh

. /lib/functions.sh

check_and_get_server() {
	local target="$1"
	local found=0

	# 1. 优先尝试按 UCI 节点 ID 直接读取
	local ip mac user pass
	ip=$(uci -q get serverctl."$target".ip)
	if [ -n "$ip" ]; then
		TARGET_IP="$ip"
		TARGET_MAC=$(uci -q get serverctl."$target".mac)
		TARGET_USER=$(uci -q get serverctl."$target".user)
		TARGET_PASS=$(uci -q get serverctl."$target".password)
		return 0
	fi

	# 2. 若未获取到，则按 option name 遍历查找
	cb_check() {
		local section="$1"
		local name
		config_get name "$section" name
		if [ "$name" = "$target" ]; then
			config_get TARGET_IP "$section" ip
			config_get TARGET_MAC "$section" mac
			config_get TARGET_USER "$section" user
			config_get TARGET_PASS "$section" password
			found=1
		fi
	}

	config_load serverctl
	config_foreach cb_check server
	[ $found -eq 1 ] && return 0 || return 1
}

# 优化后的 TCP 22 端口检测函数
test_ssh_port() {
	local ip="$1"
	local port=22

	# 方法 1：使用 Bash/ASH 内置的 /dev/tcp 进行原生 TCP 握手检测
	timeout 2 sh -c "exec 3<>/dev/tcp/$ip/$port" 2>/dev/null
	if [ $? -eq 0 ]; then
		return 0
	fi

	# 方法 2：兼容性回退使用 nc 测试
	if nc -z -w 3 "$ip" "$port" 2>/dev/null; then
		return 0
	fi

	return 1
}

do_execute() {
	read -r input
	local server action
	server=$(echo "$input" | jsonfilter -e '@.server' 2>/dev/null)
	action=$(echo "$input" | jsonfilter -e '@.action' 2>/dev/null)

	if [ -z "$server" ] || [ -z "$action" ]; then
		echo '{"code": 1, "msg": "参数不能为空"}'
		return
	fi

	if ! check_and_get_server "$server"; then
		echo '{"code": 1, "msg": "未找到对应的服务器配置"}'
		return
	fi

	case "$action" in
		ping)
			if ping -c 1 -W 2 "$TARGET_IP" >/dev/null 2>&1; then
				echo '{"code": 0, "msg": "Ping 测试成功，服务器在线！"}'
			else
				echo '{"code": 1, "msg": "Ping 测试失败，服务器不在线或防火墙禁 Ping！"}'
			fi
			;;
		sshtest)
			if test_ssh_port "$TARGET_IP"; then
				echo '{"code": 0, "msg": "SSH 22 端口连通正常！"}'
			else
				echo '{"code": 1, "msg": "无法连接到 SSH 22 端口，请检查服务器 SSH 服务或防火墙！"}'
			fi
			;;
		wake)
			if [ -n "$TARGET_MAC" ]; then
				etherwake -i br-lan "$TARGET_MAC" 2>/dev/null || wol "$TARGET_MAC" 2>/dev/null
				echo '{"code": 0, "msg": "唤醒魔术包已成功发送！"}'
			else
				echo '{"code": 1, "msg": "未配置 MAC 地址，无法发送唤醒包！"}'
			fi
			;;
		sleep)
			if [ -n "$TARGET_PASS" ] && command -v sshpass >/dev/null 2>&1; then
				sshpass -p "$TARGET_PASS" ssh -o StrictHostKeyChecking=no -o ConnectTimeout=3 "${TARGET_USER}@${TARGET_IP}" "sudo systemctl suspend" >/dev/null 2>&1 &
			else
				ssh -o StrictHostKeyChecking=no -o ConnectTimeout=3 "${TARGET_USER}@${TARGET_IP}" "sudo systemctl suspend" >/dev/null 2>&1 &
			fi
			echo '{"code": 0, "msg": "休眠指令已发送！"}'
			;;
		poweroff)
			if [ -n "$TARGET_PASS" ] && command -v sshpass >/dev/null 2>&1; then
				sshpass -p "$TARGET_PASS" ssh -o StrictHostKeyChecking=no -o ConnectTimeout=3 "${TARGET_USER}@${TARGET_IP}" "sudo poweroff" >/dev/null 2>&1 &
			else
				ssh -o StrictHostKeyChecking=no -o ConnectTimeout=3 "${TARGET_USER}@${TARGET_IP}" "sudo poweroff" >/dev/null 2>&1 &
			fi
			echo '{"code": 0, "msg": "关机指令已发送！"}'
			;;
		*)
			echo '{"code": 1, "msg": "未知操作类型"}'
			;;
	esac
}

case "$1" in
	list)
		echo '{"execute": {"server": "str", "action": "str"}}'
		;;
	call)
		case "$2" in
			execute)
				do_execute
				;;
			*)
				echo '{"code": 1, "msg": "Method not found"}'
				;;
		esac
		;;
esac
