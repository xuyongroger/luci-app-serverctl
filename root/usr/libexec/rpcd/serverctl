#!/bin/sh

. /lib/functions.sh

TARGET_IP=""
TARGET_MAC=""
TARGET_USER=""
TARGET_PASS=""

# 读取配置
check_and_get_server() {
	local target="$1"
	config_load serverctl
	
	config_get TARGET_IP "$target" ip
	config_get TARGET_MAC "$target" mac
	config_get TARGET_USER "$target" user
	config_get TARGET_PASS "$target" password
	
	[ -n "$TARGET_IP" ] && return 0 || return 1
}

# 解决问题 2：利用 SSH 输出日志精准判断端口真实状态
test_ssh_port() {
	local ip="$1"
	local res
	
	# 使用短超时参数测试 SSH 连接，并捕获错误输出
	res=$(ssh -o BatchMode=yes -o ConnectTimeout=2 -o StrictHostKeyChecking=no "${ip}" "exit" 2>&1)
	
	# 如果包含以下关键词，说明物理上根本连不通（关机或断网）
	if echo "$res" | grep -qE "Connection refused|Connection timed out|No route to host|Network is unreachable"; then
		return 1
	else
		# 哪怕密码错误/被拒绝，只要没报上述网络错误，说明 22 端口是存活的
		return 0
	fi
}

do_execute() {
	read -r input
	local server action
	server=$(echo "$input" | jsonfilter -e '@.server' 2>/dev/null)
	action=$(echo "$input" | jsonfilter -e '@.action' 2>/dev/null)

	if [ -z "$server" ] || [ -z "$action" ]; then
		echo '{"code": 1, "msg": "参数不能为空"}'
		return
	fi

	if ! check_and_get_server "$server"; then
		echo '{"code": 1, "msg": "未找到对应的服务器配置"}'
		return
	fi

	local ssh_opts="-o StrictHostKeyChecking=no -o ConnectTimeout=3"
	local ssh_cmd="ssh $ssh_opts -o BatchMode=yes"
	if [ -n "$TARGET_PASS" ] && command -v sshpass >/dev/null 2>&1; then
		ssh_cmd="sshpass -p $TARGET_PASS ssh $ssh_opts"
	fi

	case "$action" in
		ping)
			if ping -c 1 -W 2 "$TARGET_IP" >/dev/null 2>&1; then
				echo '{"code": 0, "msg": "Ping 测试成功，服务器在线！"}'
			else
				echo '{"code": 1, "msg": "Ping 测试失败，服务器不在线！"}'
			fi
			;;
		sshtest)
			if test_ssh_port "$TARGET_IP"; then
				echo '{"code": 0, "msg": "SSH 22 端口连通正常！"}'
			else
				echo '{"code": 1, "msg": "无法连接到 SSH 22 端口，目标已关机或网络不通！"}'
			fi
			;;
		wake)
			if [ -n "$TARGET_MAC" ]; then
				/usr/bin/etherwake -D -b -i br-lan "$TARGET_MAC" >/dev/null 2>&1 || \
				/usr/bin/wol -i 255.255.255.255 -p 9 "$TARGET_MAC" >/dev/null 2>&1
				echo '{"code": 0, "msg": "唤醒魔术包已发送！"}'
			else
				echo '{"code": 1, "msg": "未配置 MAC 地址，无法发送唤醒包！"}'
			fi
			;;
		sleep)
			# 解决问题 4：远程账号为 root，直接执行带有忽略锁的挂起指令
			local cmd="systemctl suspend -i"
			$ssh_cmd "${TARGET_USER}@${TARGET_IP}" "$cmd" >/dev/null 2>&1
			echo '{"code": 0, "msg": "挂起指令已成功发送！"}'
			;;
		poweroff)
			# 解决问题 5：直接执行关机，移除导致环境混淆的 sudo
			local cmd="systemctl poweroff"
			$ssh_cmd "${TARGET_USER}@${TARGET_IP}" "$cmd" >/dev/null 2>&1
			echo '{"code": 0, "msg": "关机指令已成功发送！"}'
			;;
		*)
			echo '{"code": 1, "msg": "未知操作类型"}'
			;;
	esac
}

case "$1" in
	list)
		echo '{"execute": {"server": "str", "action": "str"}}'
		;;
	call)
		case "$2" in
			execute)
				do_execute
				;;
			*)
				echo '{"code": 1, "msg": "Method not found"}'
				;;
		esac
		;;
esac
